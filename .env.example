# ===================================================
# SweetMarket Environment Configuration (.env.example)
# Copy this file to .env and configure real credentials
# ===================================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://sweetmarket:sweetmarket_pass@localhost:5432/sweetmarket_db?schema=public

# Server Port & URLs
PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (JWT)
# Generate high-entropy 256-bit secrets (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production_min32chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production_min32chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Initial Admin Bootstrap
ADMIN_EMAIL=fayzullohumidjanov@gmail.com
ADMIN_INITIAL_PASSWORD=AdminSecurePassword2026!

# Telegram Bot API Integration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_example
TELEGRAM_BOT_USERNAME=SweetMarketBot

# File Storage Configuration (local or s3)
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_STORAGE_KEY=
UPLOAD_STORAGE_SECRET=
UPLOAD_DIR=./uploads

# Optional Email / Notification Service
EMAIL_PROVIDER_API_KEY=

